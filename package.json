{
  "name": "gta-bedstuy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GTA Bed-Stuy: a non-commercial fan tribute set on ten blocks around Throop Ave & Kosciuszko St, Brooklyn. Not affiliated with Rockstar Games or Take-Two.",
  "engines": { "node": ">=20.19" },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "artifact": "vite build && node scripts/make-artifact.mjs",
    "build:hosted": "node scripts/build-hosted.mjs --only hosted",
    "build:all": "node scripts/build-hosted.mjs",
    "smoke:hosted": "node scripts/build-hosted.mjs --only hosted --smoke --port 4307"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
